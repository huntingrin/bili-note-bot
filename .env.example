# 复制为 .env 后填写。任何值都不要提交到 git。
# cp .env.example .env
#
# 默认通道是 ego：直接驱动本机已登录的 ego lite 浏览器，
# 因此【不需要】SESSDATA / BILI_JCT / DEDEUSERID。

# ---- 多模态模型（OpenAI 兼容）--------------------------------------------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# ---- 交付通道 ------------------------------------------------------------
# ego = 本机已登录浏览器（默认，免 cookie）；api = 旧的 cookie + wbi 实现
DELIVERY=ego
# bot 自己的 B 站昵称：只处理正文里 @ 了它的「回复我的」通知（自己视频下的 @）
# 留空 = 只读「@ 我的」通道。示例：填你自己的账号昵称
BOT_UNAME=
# 可选：ego-browser 绝对路径（默认从 PATH / ~/.local/bin 查找）
# EGO_BIN=/Users/you/.local/bin/ego-browser

# ---- 旧通道（DELIVERY=api 时才需要）--------------------------------------
SESSDATA=
BILI_JCT=
DEDEUSERID=

# ---- 业务开关 ------------------------------------------------------------
# 只服务这几个 mid（逗号分隔，留空 = 不限制，但会打 warn）
ALLOW_MIDS=
# 每天最多真实发送几条
DAILY_LIMIT=3
# 轮询间隔（秒），仅 --loop 使用
POLL_INTERVAL=600
# 超过这个时长的视频直接跳过（分钟）
MAX_DURATION_MIN=30
# 单个步骤失败重试次数，上限 2
MAX_RETRIES=2
# 抽帧数量上限（默认 12；实际按视频时长自适应 4~12）
FRAME_COUNT=12

# 可选：自定义 UA（旧通道用）
# BILI_USER_AGENT=
